TERM	EQU	19
	ORIG	3000
* Program
START	LDA	Y
	DECA	1
	STA	Y
TOP	LDA	Y
	INCA	1
	STA	Y
* E1	G=7
	ENTA 	0
	LDX 	Y
	DIV	=19=
	INCX	1
	STX	G
* E2	C=16
	ENTA	0
	LDX	Y
	DIV	=100=
	INCA	1
	STA	C
* E3	X=0, Z=0
	LDA	C
	ENTX	0
	MUL	=3=
	ENTA	0
	DIV	=4=
	DECA	12
	STA	X
	LDA	C
	ENTX	0
	MUL	=8=
	INCX	5
	ENTA	0
	DIV	=25=
	DECA	5
	STA	Z
* E4	D=1968
	LDA	Y
	MUL	=5=
	ENTA	0
	DIV	=4=
	SUB	X
	DECA	10
	STA	D
* E5	E=7
	LDA	G
	MUL	=11=
	INCX	20
	STX	E
	LDA	E
	ADD	Z
	SUB	X
	STA	E
	LDX	E
	ENTA	0
	DIV	=30=
	STX	E
	CMPX	=25=
	JNE	2N
	LDA	G
	CMPA	=11=
	JLE	2N
2N	CMPX	=24=
	JNE	E6
	INCX	1
	STX	E
* E6	N=37
E6	ENTA	44
	SUB	E
	STA	N
	CMPA	=21=
	JGE	E7
	INCA	30
	STA	N
* E7	N=41
E7	LDA	N
	ADD	D
	STA	NBANK
	LDX	NBANK
	ENTA	0
	DIV	=7=
	STX	NBANK
	LDA	N
	INCA	7
	SUB	NBANK
	STA	N
* E8
	ENT1	0
	LDA	N
	CMPA	=31=
	JLE	PRINT
	DECA	31
	ENT1	1
PRINT	CHAR
	LDA	MARCH,1
	STX	DAY(1:2)
	STA	MONTH
	LDA	Y
	CHAR
	STX	YEAR(1:4)
	OUT	DAY(TERM)
NEXT	LDA	Y
	CMPA	=2000=
	JL	TOP
	HLT
* Constants
Y	CON	1950
G	CON	0
C	CON	0
X	CON	0
Z	CON	0
D	CON	0
E	CON	0
N	CON	0
NBANK	CON	0
* Message
MARCH	ALF	"MARCH"
APRIL	ALF	"APRIL"
DAY	ALF	"DD   "
MONTH	ALF	"MMMMM"
	ALF	",    "
YEAR	ALF	"YYYY "
	ORIG	DAY+20
	END 	START
