READER	EQU	16
PUNCH	EQU	17
INPUT	ORIG	*+16
BUFFER	CON	0
OUTPUT	ORIG	*+16
CURRENT	CON	0
XSTORE	CON	0
*
GETCHAR	STJ	2F
3H	J6N	1F
	IN	INPUT(READER)
	JBUS	*(READER)
	ENN6	16
1H	JXNZ	4F
	LDX	INPUT+16,6
	INC6	1
4H	ENTA	0
	SLAX	1
	JAZ	3B
2H	JMP	*
*
IN1	STJ	2F
4H	JMP	GETCHAR
	CMPA	=40=
	JNE	5F
	JMP	OUT1
	OUT	OUTPUT(PUNCH)
	JMP	2F
5H	CMPA	CURRENT
	JE	3F
	JMP	OUT1
	STA	CURRENT
	ENT2	0
3H	INC2	1
	JMP	4B
2H	JMP	*
*
OUTCHAR	STJ	2F
	CMP4	=6=
	JNE	4F
	ENT4	1
	INC3	1
4H	CMP3	=16=
	JNE	3F
	OUT	OUTPUT(PUNCH)
	ENT1	OUTPUT
	MOVE	-1,1(16)
	ENT3	0
3H	STA	8F(1:2)
	ST4	7F(1:2)
7H	ENTA	*
	MUL	=9=
	STX	5F(4:4)
8H	ENTA	*
5H	STA	OUTPUT,3(0)
	INC4	1
2H	JMP	*
*
OUT1	STJ	2F
	STX	XSTORE
	STA	4F(1:2)
	CMP2	=2=
	JL	3F
	ST2	5F(1:2)
5H	ENTA	*
	CHAR
	STX	7F(1:2)
7H	ENTA	*
	JMP	OUTCHAR
	LDA	CURRENT
3H	JMP	OUTCHAR
6H	LDX	XSTORE
4H	ENTA	*
2H	JMP	*
*
START	JMP	GETCHAR
	STA	CURRENT
	ENTA	0
	ENTX	0
	ENT2	0
	ENT3	0
	ENT4	1
	ENN6	16
	JMP	IN1
	END	START
