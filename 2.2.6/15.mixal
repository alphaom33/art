TERM	EQU	19
CRD	EQU	16
LEFT	EQU	3:4
UP	EQU	3:4
ROW	EQU	0:2
COL	EQU	0:2
DATASZ	EQU	102
*
CRDDATA	ORIG	*+16
DATA	ORIG	*+DATASZ
PTR	ORIG	*+50
OUTBUF	ORIG	*+16
*

RDCRD	STJ	2F
	IN	CRDDATA(CRD)
	JBUS	*(CRD)
2H	JMP	*
*
RDSIZE	STJ	2F
	JMP	RDCRD
	LDX	CRDDATA
	ENTA	0
	NUM
	STA	NUMROW
	LDX	CRDDATA+1
	ENTA	0
	NUM
	STA	NUMCOL
2H	JMP	*
*
STNODES	STJ	2F
	ENT1	-DATASZ-3
3H	ENTA	DATA+DATASZ,1
	STA	DATA+DATASZ-3,1(LEFT)
	INC1	3
	J1NZ	3B
	ENT1	DATA
	ST1	A
2H	JMP	*
* OUTPUTS NODE ADDRESS INTO 6
GETNODE	STJ	2F
	ST1	3F(1:2)
	LD1	A
	CMP1	=0=
	JE	ERR
	ENT6	0,1
	LD1	0,1(LEFT)
	STZ	0,6
	STZ	1,6
	STZ	2,6
	ST1	A
3H	ENT1	*
2H	JMP	*
* NODE ADDRESS IN 6
DIENODE	STJ	2F
	ST1	3F(1:2)
	LD1	A
	ST1	0,6(LEFT)
	ENT1	0,6
	ST1	A
3H	ENT1	*
2H	JMP	*
*
STGRPH	STJ	2F
	LD3	NUMCOL
3H	JMP	GETNODE
	ENTA	0,6
	STA	1,6(UP)
	ENTA	-1
	STA	0,6(ROW)
	CMP3	NUMCOL
	JL	4F
	ST6	COL0
4H	INC3	-1
	J3NZ	3B
	LD3	NUMROW
3H	JMP	GETNODE
	ENTA	0,6
	STA	0,6(LEFT)
	ENTA	-1
	STA	1,6(COL)
	CMP3	NUMROW
	JL	4F
	ST6	ROW0
4H	INC3	-1
	J3NZ	3B
2H	JMP	*
* OUTPUTS NODE ADDRESS INTO 6
RDNODE	STJ	2F
	JMP	RDCRD
	JMP	GETNODE
	ENTA	0
	ENTX	0
	LDX	CRDDATA(1:3)
	NUM
	STA	0,6(ROW)
	ENTA	0
	ENTX	0
	LDA	CRDDATA+1(1:1)
	LDX	CRDDATA(4:5)
	SLA	4
	SLC	1
	NUM
	STA	1,6(COL)
	ENTA	0
	LDX	CRDDATA+2
	CMPX	=45=
	JNE	3F
	ENNA	0
3H	LDX	CRDDATA+3
	NUM
	STA	2,6
2H	JMP	*
* NODE ADDRESS IN 6, OUTPUTS ROW/COL ADDRESS INTO 5
GETROW	STJ	2F
	LDA	0,6(ROW)
	LD5	ROW0
	JMP	3F
GETCOL	STJ	2F
	LDA	1,6(COL)
	LD5	COL0
	JMP	3F
* ROW/COL IN A INITIAL IN 5
GETYEP	STJ	2F
3H	MUL	=3=
	INCX	-3
	STX	3F(1:2)
3H	INC5	*
2H	JMP	*
*
GOUP	STJ	2F
	LD6	1,6(UP)
2H	JMP	*
*
GOLEFT	STJ	2F
	LD6	0,6(LEFT)
2H	JMP	*
* NODE ADDRESS IN 6
ADDNODE	STJ	2F
	ST2	6F(1:2)
	ST3	7F(1:2)
	ST4	8F(1:2)
	ST5	9F(1:2)
*
	JMP	GETROW
	ST5	5F(1:2)
	ENT5	0,6
5H	ENT6	*
	LD4	1,5(COL)
4H	ENT3	0,6
	JMP	GOLEFT
	LD2	1,6(COL)
	ST2	CMPSPOT
	CMP4	CMPSPOT
	JL	4B
	ST6	0,5(LEFT)
	ST5	0,3(LEFT)
	ENT6	0,5
*
	JMP	GETCOL
	ST5	5F(1:2)
	ENT5	0,6
5H	ENT6	*
	LD4	0,5(ROW)
4H	ENT3	0,6
	JMP	GOUP
	LD2	0,6(ROW)
	ST2	CMPSPOT
	CMP4	CMPSPOT
	JL	4B
	ST6	1,5(UP)
	ST5	1,3(UP)
	ENT6	0,5
*
6H	ENT2	*
7H	ENT3	*
8H	ENT4	*
9H	ENT5	*
2H	JMP	*
* 
RDCRDS	STJ	2F
3H	JMP	RDNODE
	LD5	0,6(ROW)
	ST5	CMPSPOT
	ENTA	0
	CMPA	CMPSPOT
	JE	4F
	JMP	ADDNODE
	JMP	3B
4H	JMP	DIENODE
2H	JMP	*
* NODE ADDRESS IN 6
FINALLY	STJ	2F
*
S1	ST6	PIVOT
	LDA	2,6
	STA	ALPHA
	ENTA	0
	ENTX	1
	DIV	ALPHA
	STA	ALPHA
	ENTA	1
	STA	2,6
	JMP	GETROW
3H	ENT4	0,5 		* 4=P0
	JMP	GETCOL
	ENT2	0,5		* 2=Q0
	LD3	0,6(ROW)
	ST3	I0
	LD3	1,6(COL)
	ST3	J0
*
S2	LD4	0,4(LEFT)
	LD3	1,4(COL)	* 3=J
	J3N	S3
	ENTA	0,3
	LD5	COL0
	JMP	GETYEP
	ST5	PTR,3
	LDA	ALPHA
	MUL	2,4
	STX	2,4
	JMP	S2
*
S3	LD2	1,2(UP)
	LD1	0,2(ROW)	* 1=I
	ST1	I
	J1N	2F
	CMP1	I0
	JE	S3
	LDA	I
	LD5	ROW0
	JMP	GETYEP
	ENT1	0,5		* 1=P
	LD3	0,5(LEFT)	* 3=P1
*
S4	LD4	0,4(LEFT)
	LD5	1,4(COL)
	ST5	J
	J5NN	3F
	LDAN	ALPHA
	MUL	2,2
	STX	2,2
	JMP	S3
3H	CMP5	J0
	JE	S4
*
S5	LD6	1,3(COL)
	CMP6	J
	JLE	3F
	ENT1	0,3
	LD3	0,1(LEFT)
	JMP	S5
3H	JE	S7
*
S6	LD5	J
	LD6	PTR,5
	LD6	1,6(UP)
	LD6	0,6(ROW)
	CMP6	I
	JLE	3F
	ST6	PTR,5
	JMP	S6
3H	JMP	GETNODE
	ST5	1,6(COL)
	ST4	4F(1:2)
	ST5	1,6(COL)
	LD5	PTR,5
	LD4	1,5(UP)
	ST4	1,6(UP)
	ST6	1,5(UP)
4H	ENT4	*
	LD5	I
	ST5	0,6(ROW)
	ST3	0,6(LEFT)
	ST6	0,1(LEFT)
	ENT3	0,6
*
S7	LDAN	2,2
	MUL	2,4
	STX	CMPSPOT
	LDA	CMPSPOT
	ADD	2,3
	STA	2,3
	JAZ	S8
	LD5	J
	ST3	PTR,5
	ENT1	0,3
	LD3	0,1(LEFT)
	JMP	S4
*
S8	LD5	J
	LD5	PTR,5
	LD6	1,5(UP)
	ST6	CMPSPOT
	CMP1	CMPSPOT
	JE	3F
	LD6	1,6(UP)
	ST6	1,5(UP)
	JMP	S8
3H	LD6	1,3(UP)
	ST6	1,5(UP)
	LD5	0,3(LEFT)
	ST5	0,1(LEFT)
	ENT6	0,3
	JMP	DIENODE
	LD3	0,1(LEFT)
	JMP	S4
2H	JMP	*
*
OUTPUT	STJ	2F
	LD5	COL0
5H	ENT6	0,5
3H	JMP	GOUP
	LDA	0,6(ROW)
	JAN	4F
	ENTX	0
	CHAR
	STX	OUTBUF
	LDA	1,6(COL)
	ENTX	0
	CHAR
	STX	OUTBUF+2
	LDA	2,6
	STZ	OUTBUF+3
	JANN	6F
	ENTX	45
	STX	OUTBUF+3
6H	ENTX	0
	CHAR
	STA	OUTBUF+4
	STX	OUTBUF+5
	OUT	OUTBUF(TERM)
	JMP	3B
4H	INC5	3
	CMP5	ROW0
	JNE	5B
2H	JMP	*
*
START	JMP	STNODES
	JMP	RDSIZE
	JMP	STGRPH
	JMP	RDCRDS
	ENT6	40
	JMP	FINALLY
	JMP	OUTPUT
	HLT
*
ERR	OUT	ERRMSG(TERM)
	HLT
*
NUMCOL	CON	0
NUMROW	CON	0
COL0	CON	0
ROW0	CON	0
CMPSPOT	CON	0
ALPHA	CON	0
I0	CON	0
J0	CON	0
I	CON	0
J	CON	0
PIVOT	CON	0
A	CON	0
ERRMSG	ALF	OUT O
	ALF	F MEM
	ALF	ORY
	END	START
